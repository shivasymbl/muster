# Google OAuth. Client ID is public. Client secret stays on the server.
CLIENT_ID=
CLIENT_SECRET=

# Microsoft Entra. Client ID is public. Client secret stays on the server.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# openssl rand -base64 32
ENCRYPTION_KEY=
SESSION_SECRET=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=https://muster.asymbl.app

# Public site URL used in emails and redirects.
BASE_URL=https://muster.asymbl.app

# Mongo database name. Defaults to muster when unset.
MONGO_DB_NAME=muster

# Optional email. Leave unset to keep reminder email off.
# LISTMONK_URL=
# LISTMONK_USERNAME=
# LISTMONK_PASSWORD=
# LISTMONK_LIST_ID=
# GMAIL_APP_PASSWORD=
# MUSTER_EMAIL_ADDRESS=
